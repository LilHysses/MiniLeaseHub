<!DOCTYPE html>
<html lang="en">
<head>
    <link rel="stylesheet" href="/css/header.css">
    <link rel="icon" href="" type="image/png"> <!-- logo en la pestaña -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
</head>
<body>
    <div class="container-father">
        <nav>
            <div class="header-nav">
                <a href="/api/v1/" class="logo-title"><h2>LeaseHub</h2></a>
                <ul>
                    <li><a href="/api/v1/about">About us</a></li>
                    <li><a href="/api/v1/contact">Contact</a></li>
                    <li><a href="/api/v1/services">Services</a></li>
                    <li><a href="/api/v1/faq">FAQ</a></li>
                    <li><a href="/api/v1//propeties/allProperties">Properties</a></li>
                </ul>
            </div>
            <div class="user-options">
                <% if (user) { %>
                    <div class="user-menu">
                        <img src="<%= user.u_pfp %>" alt="Profile Picture" class="pfp">
                        <span class="user-name">
                            <%= user.u_name %>
                            <span class="arrow">▼</span>
                        </span>
                        <div class="menu-vertical">
                            <span><a href="/api/v1/profile">Profile</a></span>
                            <span><a href="/api/v1/notifications">Notifications</a></span>
                            <span><a href="/api/v1/properties/propertyUser">My Properties</a></span>
                            <span><a href="/api/v1/logout">Log out</a></span>
                        </div>
                    </div>
                <% } else { %>
                    <button onclick="location.href='/api/v1/register'">Sign up</button>
                    <button onclick="location.href='/api/v1/login'">Log in</button>
                <% } %>
            </div>
        </nav>